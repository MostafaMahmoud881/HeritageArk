# ─── Development overrides (takes precedence over .env in NODE_ENV=development) ───

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/heritageverse"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_GA_ID=

# Mapbox (interactive globe) — https://account.mapbox.com/auth/signup/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=

# Auth
JWT_SECRET=development-secret-do-not-use-in-production

# ─── AI Providers — fallback chain: OpenAI → Groq → Gemini → Local ───
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
LLM_API_KEY=
LLM_ENDPOINT=
LLM_MODEL=gpt-4o-mini

# HuggingFace - for image generation (Stable Diffusion / FLUX)
HF_TOKEN=

# Groq (free, no credit card) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_ENDPOINT=
GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini (free) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ElevenLabs TTS (premium voices) — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Vercel
VERCEL_API_KEY=

# Storage — S3-compatible (MinIO / R2 / AWS). Falls back to local disk when empty.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_PUBLIC_URL=
NEXT_PUBLIC_CDN_URL=

# SMTP — https://ethereal.email/ for dev testing
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@heritageverse.org
